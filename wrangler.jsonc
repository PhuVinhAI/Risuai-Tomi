{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "risuai-tomi",
    "main": "./cloudflare-worker.js",
    "compatibility_date": "2025-12-26",
    "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
    }
}
